# Frontend environment variables — copy to .env and fill in.
#
# WARNING: Vite inlines every VITE_* variable into the JavaScript bundle at
# build time, so these values are visible to anyone in the browser. Never put
# a secret here — no API keys, no database URLs, no signing keys.

# Base URL of the backend API.
# Local: http://localhost:8000   Deployment: the deployed backend URL.
VITE_API_BASE_URL=
