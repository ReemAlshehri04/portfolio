# Backend environment variables — copy to .env and fill in.
# Never commit the real .env: it is gitignored on purpose.

# PostgreSQL connection string.
# Local:      postgresql://USER:PASSWORD@localhost:5432/healthy_meals_db
# Deployment: use the DATABASE_URL provided by the host (e.g. Railway Postgres),
#             not a localhost URL.
DATABASE_URL=

# Secret used to sign JWT access tokens (HS256).
# Generate a strong random value — do not reuse one from another environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Moyasar API key. Use the sandbox key (sk_test_...) for development.
MOYASAR_SECRET_KEY=

# Frontend origin, added to the CORS allow-list.
# Local: http://localhost:5173   Deployment: the deployed frontend URL.
FRONTEND_URL=

# Where Moyasar sends the customer's browser back after 3-D Secure.
# Local: leave empty (defaults to http://127.0.0.1:8000/api/payments/callback).
# Deployment: MUST be set to https://<backend-domain>/api/payments/callback,
# or deployed payments never confirm (see BUG-14 in Stage4/testing/bug-report.md).
MOYASAR_CALLBACK_URL=

# Where the payment callback redirects the browser afterwards.
# Local: leave empty (defaults to http://localhost:5173).
# Deployment: the deployed frontend URL.
FRONTEND_BASE_URL=
